/* Cyberpunk Dashboard Styles */

Screen {
    background: #0a0a0a;
}

#title {
    text-align: center;
    color: #00ff00;
    text-style: bold;
    background: #0a0a0a;
    border: heavy #00ff00;
    height: 7;
    margin: 0 1;
}

#main-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 1;
    height: 100%;
    padding: 0 1;
}

CPUMonitor {
    color: #00ffff;
    background: #0a0a0a;
    border: heavy #00ffff;
}

WeatherWidget {
    color: #ff00ff;
    background: #0a0a0a;
    border: heavy #ff00ff;
}

CurrencyWidget {
    color: #ffd700;
    background: #0a0a0a;
    border: heavy #ffd700;
}

ClockWidget {
    color: #0080ff;
    background: #0a0a0a;
    border: heavy #0080ff;
}

#footer {
    dock: bottom;
    height: 3;
    background: #1a1a1a;
    color: #00ff00;
    text-align: center;
    border-top: heavy #00ff00;
}

Static {
    background: #0a0a0a;
}

.matrix-bg {
    color: #00ff00 20%;
}

.error {
    color: #ff0000;
}

.success {
    color: #00ff00;
}

.warning {
    color: #ffff00;
}

.info {
    color: #00ffff;
}
